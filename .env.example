# Sahay (सहाय) Environment Configuration Example
# Copy to .env.local for local development

# Optional: Google Gemini API Key for live multimodal LLM & Vision analysis.
# If omitted, Sahay operates in grounded departmental rules engine mode with synthetic ground-truth records.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Supabase / Postgres cloud sync (cross-device saved docs).
# If omitted, app stays local-first with zero cloud retention.
SUPABASE_URL=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Application Port (default 3000)
PORT=3000

# Node Environment
NODE_ENV=development
