# JibonSathi AI Environment Configuration Example
# Copy to .env.local for local development

# Optional: Google Gemini API Key for live multimodal LLM analysis.
# If omitted, JibonSathi AI operates in grounded departmental rules engine mode with synthetic ground-truth records.
GEMINI_API_KEY=your_gemini_api_key_here

# Application Port (default 3000)
PORT=3000

# Node Environment
NODE_ENV=development
